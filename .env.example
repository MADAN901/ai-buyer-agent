# LLM provider: anthropic | openai | mock (mock = no API key, deterministic demo)
LLM_PROVIDER=mock

# API keys (only needed when LLM_PROVIDER is anthropic or openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model override (provider-specific default if empty)
MODEL_NAME=

# Database (SQLite file, zero setup)
DATABASE_URL=sqlite:///./data/purchasing_agent.db

# Agent guardrails
MAX_AGENT_ITERATIONS=3
MAX_TOOL_CALLS=40
AUTO_APPROVE_LIMIT=5000

# Mock supplier chaos mode (partial/reject/timeout injection)
MOCK_SUPPLIER_CHAOS=false

# CORS / URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
